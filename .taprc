allow-incomplete-coverage: false
allow-empty-coverage: false
statements: 55
branches: 80
functions: 35
lines: 55
coverage-report:
  - text
exclude:
  - live/**
  - src/examples/**
  - test/fixtures/**
test-env:
  - EASEE_USERNAME
  - EASEE_PASSWORD
  - EASEE_CHARGERID
  - EASEE_SITEID
  - EASEE_CIRCUITID
  - EASEE_DEBUG
  - EASEE_THROW_ERRORS_ON_FAULT
