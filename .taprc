allow-incomplete-coverage: false
allow-empty-coverage: false
statements: 98
branches: 95
functions: 98
lines: 98
coverage-report:
  - text
exclude:
  - live/**
  - src/examples/**
  - test/fixtures/**
test-env:
  - EASEE_USERNAME
  - EASEE_PASSWORD
  - EASEE_CHARGERID
  - EASEE_SITEID
  - EASEE_CIRCUITID
  - EASEE_DEBUG
  - EASEE_THROW_ERRORS_ON_FAULT
