{
  "name": "easee-js-slim",
  "version": "2.1.0",
  "description": "Easee EV charger simple API for Node and server integrations",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "type": "module",
  "readme": "README.md",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "tap",
    "test:live": "node --env-file-if-exists=.env live/discovery.live.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "example": "node --env-file-if-exists=.env src/examples/integrationExamples.js"
  },
  "author": "Joel Cassel",
  "license": "MIT",
  "keywords": [
    "EV charging",
    "Nodejs",
    "Easee API",
    "Home charger",
    "Smart charging",
    "Easee",
    "Home automation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joelcassel/easee-js-slim.git"
  },
  "dependencies": {
    "axios": "^1.19.0"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "tap": "^21.7.5"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
