    "Smart charging",
    "Easee",
    "Home automation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/joelcassel/easee-js-slim.git"
  },
  "dependencies": {
    "axios": "^1.8.4"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "tap": "^21.7.5"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
